# Keep the repository focused on editable theme files, not the 30+ GB runtime.
*
!*/
!/.gitignore
!/.gitattributes
!/README.md
!/docs/**
!/tools/*.py
!/requirements*.txt
!/android-preview/*.py
!/android-preview/*.ps1
!/android-preview/*.cmd
!/android-preview/*.md
!/rhine_exact/*.md
!/rhine_exact/src/**
!/rhine_exact/assets/fonts/**
!/rhine_exact/assets/static/**
!/rhine_exact/assets/zhuangfangyi/wallpaper-portrait.png
!/rhine_exact/assets/zhuangfangyi/terminal-cover.png
!/rhine_exact/assets/zhuangfangyi/README.md
!/rhine_exact/design/**
!/rhine_exact/output/**/*.clip.txt
!/rhine_exact/output/**/preset.json
!/rhine_exact/output/**/*.md
!/rhine_exact/output/**/*.svg
!/rhine_exact/output/hyperos-klwp-v0.13.51/Rhine-UI-HyperOS-v0.13.51.klwp
!/rhine_theme/src/**
!/rhine_theme/docs/**
!/rhine_theme/README.md
!/rhine_reference/*.md
!/rhine_reference/**/*.md
**/__pycache__/
**/node_modules/
**/.env*
**/*cookie*
**/*credential*
**/*.log
**/*.xml
**/*.mp4
**/*.apk
**/*.exe
**/*.dll
**/*.pyc
**/*-verified.png
**/current-ui.*
/docs/backup-manifest.json
# Truncated historical clipboard capture; not valid theme data.
/rhine_exact/output/live-bar-text-glow-before.clip.txt
/android-preview/sdk/
/android-preview/avd/
/android-preview/downloads/
/android-preview/apps/
/android-preview/logs/
/android-preview/scrcpy/
/rhine_exact/tools/
/rhine_exact/analysis/
/tmp/
/video_results/
/output/
